{
  "name": "expo-google-credential-auth",
  "version": "0.2.0",
  "description": "Sign in with Google for Expo / React Native on Android and iOS — Android's modern Credential Manager API and the iOS GoogleSignIn SDK. Returns an ID token via a one-tap / account-picker flow, with a separate authorization flow for OAuth access tokens.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android/build.gradle",
    "android/src/main/",
    "ios/",
    "app.plugin.js",
    "build/",
    "src/",
    "expo-module.config.json",
    "README.md",
    "TESTING.md"
  ],
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "npm run test:types && npm run test:android",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:android": "cd example/android && ./gradlew :expo-google-credential-auth:testDebugUnitTest",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "google",
    "google-sign-in",
    "google-signin",
    "credential-manager",
    "android",
    "ios",
    "googlesignin",
    "oauth",
    "id-token",
    "authentication"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagnik2001/expo-google-credential-auth.git"
  },
  "bugs": {
    "url": "https://github.com/sagnik2001/expo-google-credential-auth/issues"
  },
  "author": "Sagnik Pal <sagnik@newme.asia> (https://github.com/sagnik2001)",
  "license": "MIT",
  "homepage": "https://github.com/sagnik2001/expo-google-credential-auth#readme",
  "devDependencies": {
    "@types/react": "~19.1.1",
    "expect-type": "^1.3.0",
    "expo": "^55.0.24",
    "expo-module-scripts": "^55.0.2",
    "react-native": "0.82.1"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
